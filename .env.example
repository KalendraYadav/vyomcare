# ─── VyomCare Docker Infrastructure — Root .env.example ─────────────────────
# Template for root .env (read by docker-compose.yml).
# Copy this to .env and fill in values before running Docker.
#
# docker cp: cp .env.example .env   (then edit .env)
# ──────────────────────────────────────────────────────────────────────────────

# ─── MySQL Container ─────────────────────────────────────────────────────────
# The database and user that Prisma (NestJS) will connect to.
MYSQL_DATABASE=biotrack_dev
MYSQL_USER=biotrack
MYSQL_PASSWORD=<GENERATE_STRONG_PASSWORD>
MYSQL_ROOT_PASSWORD=<GENERATE_STRONG_ROOT_PASSWORD>
MYSQL_PORT=3306

# Secret generation (run in terminal):
#   node -e "require('crypto').randomBytes(32).toString('hex')"
# or
#   openssl rand -hex 32

# ─── Redis Container ─────────────────────────────────────────────────────────
REDIS_PORT=6379
