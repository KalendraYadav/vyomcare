# ─── VyomCare — Root .gitignore ──────────────────────────────────────────────

# ─── Environment files (real secrets — NEVER commit) ─────────────────────────
.env
.env.local
.env.*.local
# Allow the example templates to be committed
!.env.example

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
*/node_modules/

# ─── Build outputs ───────────────────────────────────────────────────────────
dist/
*/dist/
.next/
*/.next/
out/
build/
coverage/

# ─── OS / editor artifacts ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Docker overrides ─────────────────────────────────────────────────────────
docker-compose.override.yml
