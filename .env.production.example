# ─── VyomCare / BioTrack — Production Environment Variables ─────────────────
# Copy this file to .env.production on your production host before starting containers:
#   cp .env.production.example .env.production
#
# CRITICAL SECURITY RULE:
# NEVER commit .env.production or any file containing real passwords/secrets to Git.
# NEVER prefix secrets, database passwords, or JWT keys with NEXT_PUBLIC_.
# ──────────────────────────────────────────────────────────────────────────────

# ─── 1. Public Frontend Configuration (Exposed to Browsers) ─────────────────
# When hosted behind Nginx reverse proxy on the same domain, relative paths work best:
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=/notifications

# If hosting API on a separate subdomain:
# NEXT_PUBLIC_API_URL=https://api.biotrack.example.com/api
# NEXT_PUBLIC_SOCKET_URL=https://api.biotrack.example.com/notifications

# ─── 2. Reverse Proxy & Host Ports ──────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ─── 3. MySQL 8.0 Database Configuration (Internal Only) ─────────────────────
# Generate strong, randomized passwords (e.g. `openssl rand -hex 32`)
MYSQL_DATABASE=biotrack_prod
MYSQL_USER=biotrack_app
MYSQL_PASSWORD=change_me_to_a_secure_app_password_32chars
MYSQL_ROOT_PASSWORD=change_me_to_a_secure_root_password_32chars

# ─── 4. JWT & Authentication Secrets (Internal Only) ─────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_cryptographically_secure_jwt_secret_64chars
JWT_EXPIRY=15m

REFRESH_TOKEN_SECRET=change_me_to_a_cryptographically_secure_refresh_secret_64chars
REFRESH_TOKEN_EXPIRY=7d

# ─── 5. CORS & Origin Hardening (Backend) ────────────────────────────────────
# Set this to the public URL of your frontend. Never use wildcard (*) in production.
# Multiple origins can be comma-separated: https://biotrack.example.com,https://admin.biotrack.example.com
CORS_ORIGIN=https://biotrack.example.com
