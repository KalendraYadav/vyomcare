# ─── BioTrack Backend — .env.example ─────────────────────────────────────────
# Template for the backend .env file.
# Copy to .env and fill in all required values before running the backend.
#
# IMPORTANT:
#   - .env is .gitignored — never commit secrets.
#   - .env.example IS committed — keep placeholders, never real values.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# MySQL connection string.
# Development: NestJS runs on host, MySQL runs in Docker.
#   DATABASE_URL=mysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/<DB_NAME>
#
# Production: Replace with your production MySQL service endpoint.
#   DATABASE_URL=mysql://<USER>:<PASSWORD>@<HOST>:3306/<DB_NAME>
#
# NOTE: If NestJS were running inside a Docker container, use the Docker
#       service name (e.g., "mysql") instead of "localhost".
DATABASE_URL="mysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/<DB_NAME>"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Development: Redis runs in Docker, NestJS on host → use localhost.
# Production: Replace with production Redis endpoint.
REDIS_URL="redis://localhost:6379"

# ─── JWT Authentication ───────────────────────────────────────────────────────
# REQUIRED. Generate with:
#   node -e "require('crypto').randomBytes(64).toString('hex')"
# or:
#   openssl rand -hex 64
#
# Use DIFFERENT values for JWT_SECRET and REFRESH_TOKEN_SECRET.
JWT_SECRET=<GENERATE_STRONG_64_BYTE_HEX_SECRET>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=<GENERATE_STRONG_64_BYTE_HEX_SECRET_DIFFERENT_FROM_ABOVE>
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Development: http://localhost:3000
# Production: Your production frontend URL (e.g. https://biotrack.example.com)
CORS_ORIGIN=http://localhost:3000

# ─── S3 / Object Storage (Cloudflare R2 or AWS S3) ───────────────────────────
# Required only if testing photo upload functionality.
# Leave as placeholder to skip in development.
S3_BUCKET_NAME=biotrack-photos
S3_REGION=auto
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<YOUR_S3_ACCESS_KEY>
S3_SECRET_ACCESS_KEY=<YOUR_S3_SECRET_KEY>
