# ─── BioTrack Backend — .gitignore ───────────────────────────────────────────

# ─── Environment files (never commit real secrets) ───────────────────────────
.env
.env.local
.env.*.local
# Allow the template to be committed
!.env.example

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Build output ────────────────────────────────────────────────────────────
dist/

# ─── Prisma generated client (regenerated via "prisma generate") ─────────────
# Prisma generates to node_modules/@prisma/client, covered above

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS artifacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
